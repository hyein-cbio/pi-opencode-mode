{
  "name": "pi-opencode-mode",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Pi extension that runs OpenCode CodeMode v2 as the codemode_o tool.",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.js",
    "route.js",
    "renderer.js",
    "LICENSE",
    "README.md",
    "TESTING.md"
  ],
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "scripts": {
    "test": "node --test test/extension.test.js test/route.test.js test/renderer.test.js test/readme.test.js test/boundaries.test.js test/session.test.js",
    "test:pi-versions": "node --test test/pi-versions.test.js"
  },
  "dependencies": {
    "@opencode/codemode": "2.1.0",
    "acorn": "8.15.0",
    "effect": "4.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0",
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "1.3.27"
  }
}
