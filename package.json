{
  "name": "pi-opencode-mode",
  "version": "0.1.4",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "Pi extension that runs OpenCode CodeMode v2 as the codemode_o tool.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyein-cbio/pi-opencode-mode.git"
  },
  "homepage": "https://github.com/hyein-cbio/pi-opencode-mode#readme",
  "bugs": {
    "url": "https://github.com/hyein-cbio/pi-opencode-mode/issues"
  },
  "keywords": ["pi-package", "pi-extension", "opencode", "codemode"],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.js",
    "route.js",
    "renderer.js",
    "call-log.js",
    "source-preview.js",
    "LICENSE",
    "README.md",
    "TESTING.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "scripts": {
    "test": "node --test test/extension.test.js test/route.test.js test/preflight.test.js test/renderer.test.js test/call-log.test.js test/source-preview.test.js test/readme.test.js test/boundaries.test.js test/session.test.js",
    "test:pi-versions": "node --test test/pi-versions.test.js"
  },
  "dependencies": {
    "@opencode/codemode": "2.1.4",
    "acorn": "8.15.0",
    "effect": "4.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0 <2.0.0",
    "@earendil-works/pi-tui": ">=0.99.0 <2.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "1.3.27"
  }
}
